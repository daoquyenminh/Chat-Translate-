# GROQ_API_KEY: Primary fast free-tier LLM key from console.groq.com (no credit card required).
GROQ_API_KEY=""

# GROQ_API_KEYS: Optional comma-separated list of additional Groq keys for automatic round-robin load sharing.
GROQ_API_KEYS=""

# GROQ_MODEL: Optional override (or comma-separated priority list) of Groq model IDs.
# Default: openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
GROQ_MODEL=""

# CF_AI_MODEL: Optional override (or comma-separated priority list) of Cloudflare Workers AI model IDs.
# On Cloudflare Workers, Workers AI runs natively via the `AI` binding in wrangler.jsonc with no API key needed.
# Default: @cf/meta/llama-3.1-8b-instruct-fast,@cf/google/gemma-3-12b-it,@cf/meta/llama-3.1-8b-instruct
CF_AI_MODEL=""

# Optional: Only needed if you want local Express dev to also call Cloudflare Workers AI REST API.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# GEMINI_API_KEY: Automatic fallback tier via Google Gemini Flash Lite.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional comma-separated list of additional Gemini keys for fallback rotation.
GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
